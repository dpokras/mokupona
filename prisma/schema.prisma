generator client {
  provider      = "prisma-client"
  output        = "./generated"
  compilerBuild = "small"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String  @id @default(cuid())
  email         String  @unique
  name          String
  emailVerified Boolean @default(false)
  image         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions Session[]
  accounts Account[]

  invitesCreated Invite[]

  events Event[]

  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  roleId String
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId String

  @@index([userId])
}

model Account {
  id String @id @default(cuid())

  accountId  String
  providerId String

  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId String

  @@index([userId])
}

model Invite {
  id         String    @id @default(cuid())
  email      String
  roleName   String
  tokenHash  String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdById String

  @@index([email])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identifier])
}

model Role {
  id          String @id @default(cuid())
  name        String @unique
  description String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]
}

model Event {
  id                  String   @id @default(cuid())
  title               String
  description         String
  menuDescription     String?
  donationDescription String?
  date                DateTime
  slots               Int
  price               Int
  discounts           String?

  // the cover slot — deleting the image leaves the event standing (SetNull)
  image   Image?  @relation(fields: [imageId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  imageId String? @unique

  addressId String
  address   Address @relation(fields: [addressId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  eventResponses EventResponse[]

  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdById String?

  form   Form   @relation(fields: [formId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  formId String @unique

  galleryImages EventGalleryImage[]
}

model Form {
  id String @id @default(cuid())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions FormVersion[]
  event    Event?
}

model FormVersion {
  id      String @id @default(cuid())
  version Int
  schema  Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  form   Form   @relation(fields: [formId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  formId String

  submissions FormSubmission[]

  @@unique([formId, version])
}

model FormSubmission {
  id      String @id @default(cuid())
  answers Json

  createdAt DateTime @default(now())

  formVersion   FormVersion @relation(fields: [formVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  formVersionId String
}

model EventResponse {
  id           String   @id @default(cuid())
  name         String
  email        String
  phone        String   @default("")
  vegetarian   Boolean?
  student      Boolean?
  restrictions String?
  comment      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  eventId String
}

model Address {
  id          String  @id @default(cuid())
  streetName  String
  houseNumber String
  zip         String
  city        String
  events      Event[]

  @@unique([streetName, houseNumber, zip, city])
}

// A pure stored asset: provider metadata only, no owner FKs. Whatever shows
// an image points here — the cover/portrait slots via their own imageId, the
// galleries via EventGalleryImage links.
model Image {
  id          String  @id @default(cuid())
  altText     String?
  contentType String
  // provider key (Cloudinary public_id / local file key) — the row's only
  // link to its bytes since `blob` was dropped, so it is required
  storageKey  String
  version     Int?
  width       Int?
  height      Int?
  blurDataUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event        Event?
  boardMember  BoardMember?
  galleryLinks EventGalleryImage[]
  siteImage    SiteImage?
}

// Grants one image membership in one dinner's gallery. Deleting a link
// unlinks without destroying the asset, and the same photo can be shown
// under two dinners with different captions.
model EventGalleryImage {
  id       String  @id @default(cuid())
  caption  String?
  position Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  eventId String

  image   Image  @relation(fields: [imageId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  imageId String

  // one membership per (dinner, image) pair — re-adding is idempotent
  @@unique([eventId, imageId])
  @@index([eventId])
  @@index([imageId])
}

model BoardMember {
  id       String @id @default(cuid())
  name     String
  position String

  image   Image?  @relation(fields: [imageId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  imageId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// An admin override of one public text; absent rows fall back to the code
// default in app/features/site-content.
model SiteText {
  key   String @id
  value String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteImage {
  key String @id

  image   Image  @relation(fields: [imageId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  imageId String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FaqEntry {
  id        String  @id @default(cuid())
  question  String
  answer    String
  position  Int     @default(0)
  published Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position])
}

// One public page view. No IP, cookie or full referrer is stored; visitorId
// is a hash salted per day, so a visitor cannot be followed across days.
model PageView {
  id        String  @id @default(cuid())
  day       String
  path      String
  referrer  String?
  visitorId String
  device    String

  createdAt DateTime @default(now())

  @@index([day])
}

model VisitSalt {
  day  String @id
  salt String

  createdAt DateTime @default(now())
}
